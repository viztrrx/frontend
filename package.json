{
  "name": "frontend",
  "version": "2.0.0",
  "description": "Browser frontend of MercuryWorkshop Scramjet-App for Cloudflare Workers",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "npx wrangler dev",
    "deploy": "npx wrangler deploy",
    "test": "node --test tests/frontend.test.mjs tests/service-worker.test.mjs tests/libcurl-transport.test.mjs tests/build.test.mjs tests/sessions-api.test.mjs tests/blocked.test.mjs tests/keepalive.test.mjs tests/games.test.mjs tests/sitefixes.test.mjs",
    "build:beta": "SCRAMJET_ENGINE=2 node scripts/build.mjs",
    "deploy:beta": "npx wrangler deploy --config wrangler.beta.jsonc"
  },
  "dependencies": {
    "@mercuryworkshop/bare-mux": "^2.1.9",
    "@mercuryworkshop/epoxy-transport": "2.1.29",
    "@mercuryworkshop/libcurl-transport": "^1.5.2",
    "@mercuryworkshop/scramjet": "https://github.com/MercuryWorkshop/scramjet/releases/download/v1.1.0/mercuryworkshop-scramjet-1.1.0.tgz",
    "epoxy-transport3": "npm:@mercuryworkshop/epoxy-transport@3.0.2",
    "libcurl-transport2": "npm:@mercuryworkshop/libcurl-transport@2.0.6",
    "scramjet-controller2": "npm:@mercuryworkshop/scramjet-controller@0.0.14",
    "scramjet2": "npm:@mercuryworkshop/scramjet@2.0.67-alpha.2"
  },
  "devDependencies": {
    "eslint": "^9.13.0",
    "prettier": "^3.3.3"
  },
  "packageManager": "pnpm@10.18.3",
  "license": "AGPL-3.0-only"
}
