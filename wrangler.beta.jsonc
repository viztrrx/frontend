// The beta Worker: the same site built with Scramjet 2 (SCRAMJET_ENGINE=2),
// at https://frontend-beta.viztrrx.workers.dev. Production stays on
// wrangler.jsonc. Set up in README.md ("Scramjet 2 beta").
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "frontend-beta",
  "main": "./src/index.js",
  "compatibility_date": "2026-10-21",
  // Lets /sessions check sign-ins with the Saints Worker (donnajbe), which is on
  // the same workers.dev subdomain: without it Cloudflare refuses that fetch
  // (error 1042) and every session request reads as signed out.
  "compatibility_flags": ["global_fetch_strictly_public"],
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  // No keep-alive cron here: production's already keeps the backend awake.
  // Saved sessions (src/sessions.js) hold sign-in cookies, so they live in
  // a private bucket. The old public one is only read to move sessions
  // saved before over (each account's, the first time it's seen).
  "r2_buckets": [
    {
      "binding": "SESSIONS",
      "bucket_name": "saints-proxy-sessions"
    },
    {
      "binding": "SESSIONS_LEGACY",
      "bucket_name": "donnajbe-eaglercraft-client"
    }
  ],
  "vars": {
    // Beta sessions are kept apart from production's: Scramjet 2 stores
    // cookies its own way.
    "SESSIONS_PREFIX": "proxy-sessions-beta/"
  }
}
