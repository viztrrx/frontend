{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "frontend",
  "main": "./src/index.js",
  "compatibility_date": "2026-10-21",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "r2_buckets": [
    {
      "binding": "SESSIONS",
      "bucket_name": "donnajbe-eaglercraft-client"
    }
  ]
}
